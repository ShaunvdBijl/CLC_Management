# PostgreSQL
POSTGRES_DB=clc_management
POSTGRES_USER=clc_admin
POSTGRES_PASSWORD=clc_dev_password_change_me

# Backend ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
AUTH_MODE=DevMock # Set to "EntraId" in production
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_AUDIENCE=api://00000000-0000-0000-0000-000000000000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Storage
STORAGE_PROVIDER=Local
STORAGE_ROOT_PATH=/app/uploads/posters

# MS Teams / Power Automate Webhook (optional)
TEAMS_WEBHOOK_SECRET=change_me_for_teams_webhook

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5080
VITE_AUTH_MODE=DevMock # Set to "EntraId" in production
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
